# Symlink into the session scratch directory under /tmp; not part of the project.
/scratch

# Working material that must not be redistributed or is simply too big to
# track: source artwork whose licence does not permit shipping it, device
# photos, and the desktop KOReader build used as a test harness.
/local/

# Exported games.
*.pgn

__pycache__/
*.pyc

# Local review captures from the emulator.
/preview-*.png

# Piece sets are one folder each under pieces/, and any set can be installed
# by dropping one there -- but only the two that are ours to redistribute are
# tracked. A set built from third-party artwork stays on this machine, gets
# copied to the device by install.sh like any other, and never reaches the
# repository. Same for the contact sheets that go with them.
/kobochess.koplugin/pieces/*/
!/kobochess.koplugin/pieces/drawn/
!/kobochess.koplugin/pieces/vecteezy/
/pieces_preview-*.png
!/pieces_preview-drawn.png
!/pieces_preview-vecteezy.png

# External UCI engines. Stockfish is GPLv3 and a hundred megabytes of neural
# network; it is built by tools/build_stockfish.sh and installed to the
# device, but it does not belong in this repository.
/kobochess.koplugin/engines/

# Cobalt probe experiment (Aug 2026), kept local
cobalt-*
